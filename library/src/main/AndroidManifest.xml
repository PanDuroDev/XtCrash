<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <provider
            android:name="io.github.soufianodev.xtcrash.provider.CrashInitProvider"
            android:authorities="${applicationId}.xtcrash-init-provider"
            android:exported="false"
            android:initOrder="101" />

        <activity
            android:name="io.github.soufianodev.xtcrash.activity.DefaultErrorActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:finishOnTaskLaunch="true"
            android:launchMode="singleTask"
            android:process=":xtcrash_error"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />
    </application>

</manifest>
