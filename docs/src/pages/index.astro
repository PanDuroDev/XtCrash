---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { CardGrid, LinkCard } from '@astrojs/starlight/components';

const base = import.meta.env.BASE_URL;
const banner = `${base}xtcrash-banner.svg`;
---

<StarlightPage
  frontmatter={{
    title: 'XtCrash',
    description: 'A configurable Android crash screen that survives the crashing process.',
  }}
>
  <img
    src={banner}
    alt="XtCrash — crash recovery and custom error screens for Android"
    style="border-radius: 0.5rem; width: 100%; height: auto;"
  />

  <p>
    XtCrash replaces Android's default crash dialog with a configurable error
    screen in a dedicated process. Developers can offer restart and close
    actions, technical details, clipboard copying, and user-initiated crash
    report sharing.
  </p>

  <p>
    The core library supports Android API 23+ and has no Compose dependency.
    The optional <code>xtcrash-compose</code> module provides a hosted Compose
    activity and a composable screen. Reports are prepared locally; XtCrash
    does not upload them automatically.
  </p>

  <p><a class="sl-link-button" href={`${base}quickstart/`}>Start with Quick Start</a></p>

  <h2>Choose a guide</h2>
  <CardGrid>
    <LinkCard title="Configuration" href={`${base}configuration/`} description="Set screen behavior, text, colors, logging, and report options." />
    <LinkCard title="Custom Error Screen" href={`${base}custom-error-screen/`} description="Register a custom activity and consume the serialized crash payload." />
    <LinkCard title="Crash Reports" href={`${base}crash-reports/`} description="Configure destinations, privacy confirmation, URL limits, and custom handlers." />
    <LinkCard title="Jetpack Compose" href={`${base}compose/`} description="Compare the hosted activity, config-driven screen, and custom UI paths." />
    <LinkCard title="Logging and Event Callbacks" href={`${base}logging-and-events/`} description="Understand diagnostic logging and crash-screen lifecycle callbacks." />
    <LinkCard title="API Reference" href={`${base}api-reference/`} description="Browse generated API documentation for the core and Compose modules." />
  </CardGrid>

  <h2>Project links</h2>
  <CardGrid>
    <LinkCard title="GitHub repository" href="https://github.com/SoufianoDev/XtCrash" description="Source code, issues, and contribution guidance." />
    <LinkCard title="Contributing" href="https://github.com/SoufianoDev/XtCrash/blob/master/CONTRIBUTING.md" description="Development workflow and pull-request expectations." />
  </CardGrid>
</StarlightPage>
